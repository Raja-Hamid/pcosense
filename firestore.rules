rules_version = '2';

// PCOSense Firestore security rules.
//
// Every document under /users/{uid}/** is owned by the authenticated user
// whose Firebase Auth UID equals {uid}. Read and write are denied to
// anyone else, anywhere in the tree.
//
// Apply with:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /questionnaire_history/{assessmentId} {
        allow read, write: if isOwner(uid);
      }

      match /uploads/{uploadId} {
        allow read, write: if isOwner(uid);
      }

      match /predictions/{predictionId} {
        allow read, write: if isOwner(uid);
      }

      match /recommendations/{assessmentId} {
        allow read, write: if isOwner(uid);
      }

      match /symptom_logs/{logId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
