rules_version = '2';

// Firebase Storage rules for PCOSense ultrasound uploads.
//
// Each user can only access their own uploads under /users/{uid}/uploads/.
// Files are restricted to images up to 10 MB.
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function withinSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    match /users/{uid}/uploads/{file=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isImage() && withinSize();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
